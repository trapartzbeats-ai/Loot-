{
  "manifest_version": 3,
  "name": "Test Extension",
  "version": "1.0.0",
  "description": "A test extension for Loot Browser",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
